{
  "name": "centro-control-pc",
  "productName": "Centro de Control",
  "version": "1.0.23",
  "description": "Centro de control de PC: volumen y dispositivos de audio desde una barra",
  "main": "main.js",
  "author": "Pedro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pedro.centrocontrol",
    "productName": "Centro de Control",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "mixer.html",
      "mixer.js",
      "mixer.css",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/svcl.exe",
        "to": "svcl.exe"
      },
      {
        "from": "bin/PresentMon.exe",
        "to": "PresentMon.exe"
      },
      {
        "from": "bin/lhm",
        "to": "lhm"
      },
      {
        "from": "scripts/sensores.ps1",
        "to": "sensores.ps1"
      },
      {
        "from": "bin/iCUESDK.x64_2019.dll",
        "to": "iCUESDK.x64_2019.dll"
      },
      {
        "from": "scripts/audifonos.ps1",
        "to": "audifonos.ps1"
      },
      {
        "from": "scripts/audio.ps1",
        "to": "audio.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "CentroControl-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
